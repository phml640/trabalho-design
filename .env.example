# Valores públicos e exclusivamente demonstrativos; são os padrões do Compose.
# Copiar este arquivo para .env é opcional para docker compose up --build.
PERSISTENCIA=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestao_filas
POSTGRES_USER=gestao
POSTGRES_PASSWORD=gestao_demo_local
API_PORT=8000
FRONTEND_PORT=8080

# Opcional: tem precedência sobre as variáveis POSTGRES_* na execução sem Docker.
# DATABASE_URL=postgresql+psycopg://gestao:SENHA@localhost:5432/gestao_filas
# Testes PostgreSQL: use exclusivamente um banco separado e descartável.
# TEST_DATABASE_URL=postgresql+psycopg://gestao:SENHA@localhost:5432/gestao_filas_teste
